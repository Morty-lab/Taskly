# Public Appwrite identifiers (safe in the browser bundle)
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6b07b401003ce48ec508

# Server only. Used by the Express server for admin pages and by scripts/setup-appwrite.mjs.
# Never prefix it with VITE_ (that would ship it to every visitor).
APPWRITE_API_KEY=

# The admin account. scripts/setup-appwrite.mjs creates it (or labels it if it exists).
# The password is only read by the setup script; you can remove it from .env afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
